+def encode_text(runtime: InferenceRuntime, text: str) -> tuple[int, ...]:
+    """Tokenize one text exactly as `predict_text` does."""
+    return tuple(
+        int(tok) for tok in runtime.encoding.encode(text, allowed_special="all")
+    )
+
