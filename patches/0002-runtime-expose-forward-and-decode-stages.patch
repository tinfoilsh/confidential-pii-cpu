+@torch.inference_mode()
+def forward_window(
+    runtime: InferenceRuntime,
+    tokens: Sequence[int],
+) -> torch.Tensor:
+    """Run one window of token ids through the model.
+
+    Returns a `[len(tokens), num_classes]` float32 CPU tensor of per-token
+    class log-probabilities, the unit `predict_text` aggregates across
+    windows. Exposed so callers can run windows elsewhere (another process,
+    a worker pool) and feed the results to `decode_token_scores`.
+    """
+    window_tokens = torch.tensor(
+        [list(tokens)],
+        device=runtime.device,
+        dtype=torch.int32,
+    )
+    attention_mask = torch.ones_like(window_tokens, dtype=torch.bool)
+    logits = runtime.model(window_tokens, attention_mask=attention_mask)
+    log_probs = F.log_softmax(logits.float(), dim=-1)[0].cpu()
+    if log_probs.shape[0] != len(tokens):
+        raise ValueError("Logprob output length does not match window length")
+    return log_probs
+
